{
  "name": "homebridge-windy-camera",
  "displayName": "Rain & Weather Radar",
  "version": "2.5.5",
  "description": "Standalone Homebridge plugin: rain radar camera for Apple Home (Windy or satellite/street maps with RainViewer radar) with weather overlay, rain / rain-soon / storm / wind / UV sensors, animated radar loop and fully customizable design. No other plugin or script required.",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "windy",
    "rain",
    "radar",
    "weather",
    "camera",
    "homekit",
    "rain-sensor",
    "israel",
    "supports-hap"
  ],
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22 || ^24",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "files": [
    "index.js",
    "lib",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright-core": "^1.40.0"
  },
  "optionalDependencies": {
    "ffmpeg-for-homebridge": ">=0.1.0"
  },
  "author": "Oren Asher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orenasher/homebridge-windy-camera.git"
  },
  "bugs": {
    "url": "https://github.com/orenasher/homebridge-windy-camera/issues"
  },
  "homepage": "https://github.com/orenasher/homebridge-windy-camera#readme",
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/orenasher"
  }
}
